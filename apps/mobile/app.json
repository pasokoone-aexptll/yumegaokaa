{
  "expo": {
    "name": "夢ヶ丘",
    "slug": "yumegaoka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/yumegaoka-iOS-Default-1024@1x.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/ios/yumegaoka.icon",
      "bundleIdentifier": "jp.yumegaoka.development",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "街の範囲を端末で確認し、匿名の気配を表示するために使います。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "入街中は画面を閉じても移動先の気配を更新します。生の座標はサーバーへ送信しません。",
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocalNetworkUsageDescription": "開発中はこのMacのローカルサーバーへ接続します。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "jp.yumegaoka.development",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "街のNFCステッカーを読んで参加するために使います。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィールの写真を選択します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "yumegaoka"
  }
}
